{
  "info": {
    "name": "PRO — Project Online Repository",
    "description": "REST API for the PRO DBMS course project. Uses {{base_url}} and {{token}} collection variables — run Auth > Login (Student) first to auto-populate {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"student\",\n  \"id\": 1099,\n  \"name\": \"Test Student\",\n  \"email\": \"test.student@vitstudent.ac.in\",\n  \"department_id\": 1,\n  \"year\": 3,\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register Faculty",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"faculty\",\n  \"id\": 2099,\n  \"name\": \"Test Faculty\",\n  \"email\": \"test.faculty@vit.ac.in\",\n  \"department_id\": 1,\n  \"designation\": \"Assistant Professor\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\",\n  \"id\": 99,\n  \"name\": \"Test Admin\",\n  \"email\": \"second.admin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "description": "Only an admin can add another admin: run \"Login (Admin)\" first, which sets {{admin_token}}."
        },
        {
          "name": "Login (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.success) { pm.collectionVariables.set('token', data.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"student\",\n  \"email\": \"student@vitstudent.ac.in\",\n  \"password\": \"password123\"\n}"
            }
          },
          "description": "Sets {{token}} automatically for the DELETE routes below that require auth."
        },
        {
          "name": "Login (Faculty)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"faculty\",\n  \"email\": \"rakesh.kumar@vit.ac.in\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\",\n  \"email\": \"abg.592006@gmail.com\",\n  \"password\": \"<your admin password>\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.success) { pm.collectionVariables.set('admin_token', data.data.token); }"
                ]
              }
            }
          ],
          "description": "Sets {{admin_token}}, used by \"Register Admin\". The admin password is set with `npm run set-password`."
        }
      ]
    },
