# Copy to .env (local) and set the same names as Vercel environment variables.

# Oracle DB connection
# Local Docker (SQLcl setup):
DB_USER=system
DB_PASSWORD=25BCE0014
DB_CONNECT_STRING=localhost:1521/FREEPDB1
# Oracle Autonomous Database (free tier, TLS without a wallet): use the ADMIN
# user and paste the TLS connection string from the database's
# "Database connection" page, e.g.
# DB_USER=ADMIN
# DB_CONNECT_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<id>_<db>_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Max pooled connections per server instance (keep small on Vercel)
DB_POOL_MAX=4

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
