# Copy to .env (local) and set the same names as Vercel environment variables.

# Postgres connection. Supabase: project → Connect → Transaction pooler →
# copy the URI and put the database password in place of [YOUR-PASSWORD]
# (URL-encode symbols, e.g. @ → %40). TLS is switched on automatically for
# any host other than localhost.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local Postgres instead:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pro

# Max pooled connections per server instance (keep small on Vercel)
DB_POOL_MAX=4

# Auth
# Better Auth (web sign-in sessions). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_this_to_a_long_random_secret
# The app's public URL. Local: http://localhost:3001. On Vercel, set it to
# your production URL (preview deployments fall back to VERCEL_URL).
BETTER_AUTH_URL=http://localhost:3001
# JWT for API clients (POST /api/auth/login)
JWT_SECRET=change_this_to_a_different_long_random_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
