  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cloth action button for the role's primary action; may carry a foil dot.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><span class=\"ds-foil-dot\"></span>Register a project</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:38px;padding:0 15px;border-radius:var(--r-md);border:1px solid transparent;font-family:var(--font-ui);font-size:14px;font-weight:600;cursor:pointer;transition:background 150ms var(--ease),border-color 150ms var(--ease),color 150ms var(--ease),transform 120ms var(--ease)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.ds-btn-primary{background:var(--cloth);color:#fff}.ds-btn-primary:hover{background:var(--cloth-deep)}.ds-foil-dot{width:6px;height:6px;border-radius:50%;background:var(--foil)}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary action on paper or sheets.",
      "html": "<button class=\"ds-btn-quiet\">Cancel</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;height:38px;padding:0 15px;border-radius:var(--r-md);background:var(--sheet);color:var(--ink);border:1px solid var(--rule);font-family:var(--font-ui);font-size:14px;font-weight:600;cursor:pointer;transition:background 150ms var(--ease),border-color 150ms var(--ease)}.ds-btn-quiet:hover{border-color:#b9b2ab;background:var(--sheet-tint)}.ds-btn-quiet:active{transform:translateY(1px)}.ds-btn-quiet:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive confirmation only.",
      "html": "<button class=\"ds-btn-danger\">Delete team</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;height:38px;padding:0 15px;border-radius:var(--r-md);background:var(--danger);color:#fff;border:none;font-family:var(--font-ui);font-size:14px;font-weight:600;cursor:pointer;transition:background 150ms var(--ease)}.ds-btn-danger:hover{background:#8f1c13}.ds-btn-danger:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field with hint and field-level error.",
      "html": "<label class=\"ds-field\"><span>Project title <b>*</b></span><input class=\"ds-input\" placeholder=\"Smart Attendance System\"><small>Shown on the spine and in search.</small></label>",
      "css": ".ds-field{display:grid;gap:6px;font-family:var(--font-ui);max-width:320px}.ds-field span{font-size:13px;font-weight:600;color:var(--ink-2)}.ds-field b{color:var(--danger);font-weight:600}.ds-field small{font-size:12.5px;color:var(--muted)}.ds-input{height:38px;padding:0 12px;background:var(--sheet);border:1px solid #cfc9c3;border-radius:var(--r-md);font:inherit;font-size:14px;color:var(--ink);transition:border-color 150ms var(--ease),box-shadow 150ms var(--ease)}.ds-input::placeholder{color:#77717a}.ds-input:hover{border-color:#aaa29b}.ds-input:focus{outline:none;border-color:var(--cloth);box-shadow:0 0 0 3px rgba(201,162,74,.35)}"
    },
    {
      "name": "Cloth Top Bar",
      "kind": "nav",
      "refersTo": "top-bar",
      "description": "Sticky bookcloth bar: foil wordmark, nav with foil active rule, role stamp.",
      "html": "<nav class=\"ds-bar\"><a class=\"ds-mark\">PRO</a><a class=\"ds-nav\">Desk</a><a class=\"ds-nav\" aria-current=\"page\">Repository</a><a class=\"ds-nav\">Teams</a><span class=\"ds-stamp\">Admin</span></nav>",
      "css": ".ds-bar{height:60px;display:flex;align-items:center;gap:6px;padding:0 24px;background:var(--cloth);color:var(--cloth-ink);font-family:var(--font-ui);box-shadow:0 1px 0 var(--cloth-deep),0 4px 14px -6px rgba(40,10,15,.45)}.ds-mark{font-family:var(--font-foil);font-size:28px;letter-spacing:.04em;color:var(--foil);margin-right:18px}.ds-nav{display:flex;align-items:center;height:100%;padding:0 11px;font-size:14px;color:var(--cloth-ink-muted);text-decoration:none;cursor:pointer;box-shadow:inset 0 -3px 0 transparent;transition:color 150ms var(--ease),box-shadow 200ms var(--ease)}.ds-nav:hover{color:#fff}.ds-nav[aria-current=page]{color:#fff;box-shadow:inset 0 -3px 0 var(--foil)}.ds-stamp{margin-left:auto;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--foil);border:1.5px solid var(--foil);padding:2px 8px;border-radius:3px}"
    },
    {
      "name": "Relation Chips",
      "kind": "chip",
      "refersTo": "chip-team",
      "description": "One fixed hue per entity family; linked chips ring on hover.",
      "html": "<div class=\"ds-chips\"><a class=\"ds-chip ds-chip-team\">Neural Ninjas</a><a class=\"ds-chip ds-chip-people\">Dr. Manoj Trivedi</a><a class=\"ds-chip ds-chip-subject\">Web Development</a><a class=\"ds-chip ds-chip-project\">Chatbot</a><a class=\"ds-chip ds-chip-eval\">Score 76</a></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:6px;font-family:var(--font-ui)}.ds-chip{display:inline-flex;align-items:center;padding:2px 9px;border-radius:999px;font-size:13px;line-height:20px;font-weight:500;text-decoration:none;cursor:pointer;transition:box-shadow 150ms var(--ease)}.ds-chip:hover{box-shadow:inset 0 0 0 1.5px currentColor}.ds-chip:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.ds-chip-project{background:var(--h-project-bg);color:var(--h-project)}.ds-chip-team{background:var(--h-team-bg);color:var(--h-team)}.ds-chip-people{background:var(--h-people-bg);color:var(--h-people)}.ds-chip-subject{background:var(--h-subject-bg);color:var(--h-subject)}.ds-chip-eval{background:var(--h-eval-bg);color:var(--h-eval)}"
    },
    {
