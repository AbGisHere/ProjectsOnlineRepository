      "html": "<div class=\"ds-shelf\"><div class=\"ds-spines\"><a class=\"ds-spine\" style=\"background:var(--st-completed);height:150px\"><span>Smart Attendance</span><em>001</em></a><a class=\"ds-spine\" style=\"background:var(--st-submitted);height:120px\"><span>Chatbot</span><em>002</em></a><a class=\"ds-spine\" style=\"background:var(--st-ongoing);height:132px\"><span>IoT Irrigation</span><em>003</em></a><a class=\"ds-spine ds-rej\" style=\"background:var(--st-rejected);height:110px\"><span>Serverless</span><em>011</em></a></div><div class=\"ds-ledge\"></div><div class=\"ds-year\"><b>2025-2026</b><span>4 reports</span></div></div>",
